# ════════════════════════════════════════════════════════════
# MEKANIX — Environment Variables
# ════════════════════════════════════════════════════════════

# ─── Database ───
# Dev: SQLite
DATABASE_URL=file:/home/z/my-project/db/custom.db
# Production: PostgreSQL
# DATABASE_URL=postgresql://mekanix:password@localhost:5432/mekanix

# ─── Auth ───
JWT_SECRET=change-this-to-a-secure-secret

# ─── Admin Bootstrap (production only) ───
# ADMIN_BOOTSTRAP_PASSWORD=
# ADMIN_BOOTSTRAP_USERNAME=admin
# ADMIN_BOOTSTRAP_EMAIL=admin@mekanix.ir

# ─── Redis (optional — distributed rate limiting + idempotency) ───
# REDIS_URL=redis://localhost:6379

# ─── SMS Provider (optional — for OTP delivery) ───
# SMS_PROVIDER=console   # default (dev)
# SMS_PROVIDER=kavenegar
#   KAVENEGAR_API_KEY=your_api_key
#   KAVENEGAR_TEMPLATE=mekanix-otp
# SMS_PROVIDER=melipayamak
#   MELIPAYAMAK_USERNAME=your_username
#   MELIPAYAMAK_PASSWORD=your_password
#   MELIPAYAMAK_SENDER=5000123456
# SMS_PROVIDER=farapayamak
#   FARAPAYAMAK_USERNAME=your_username
#   FARAPAYAMAK_PASSWORD=your_password
#   FARAPAYAMAK_SENDER=5000123456

# ─── ETA Provider (optional — for real routing) ───
# NESHAN_API_KEY=your_neshan_key
# GOOGLE_MAPS_API_KEY=your_google_key
# OSRM_API_URL=https://your-osrm-server.com
