{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "mini-services",
    "examples",
    "skills",
    "experiments",
    "admin-panel",
    // ─── FEATURE INCOMPLETE: Prisma models not yet in schema.prisma ───
    // These API routes reference models (Insurance, LoyaltyPoints, MultiRating)
    // that haven't been added to the main Prisma schema yet.
    // TODO: implement these models in schema.prisma + re-enable these routes
    "src/app/api/insurance/[id]/route.ts",
    "src/app/api/loyalty",
    "src/app/api/multi-rating/route.ts"
  ]
}
